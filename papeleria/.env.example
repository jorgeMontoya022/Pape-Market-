# =============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PAPELERÍA FUNDADORES
# =============================================================
# Este archivo SÍ se sube a git. Es solo una plantilla.
# Para usar: copia este archivo como ".env" y rellena los valores.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux/Mac:            cp .env.example .env
# =============================================================

# --- BASE DE DATOS POSTGRESQL ---
DB_USERNAME=
DB_PASSWORD=

# --- CORREO SMTP (Gmail) ---
# Usa una "Contraseña de aplicación" de Google, no tu contraseña normal.
# Guía: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JWT ---
# Genera un valor seguro con: openssl rand -hex 32
# O usa cualquier generador de strings aleatorios de 64+ caracteres.
JWT_SECRET=
# Tiempo de expiración en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# --- URLS DE LA APLICACIÓN ---
RESET_PASSWORD_URL=http://localhost:8080/api/v1/auth/reset-password
