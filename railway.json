{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd papeleria && chmod +x gradlew && ./gradlew bootJar -x test"
  },
  "deploy": {
    "startCommand": "java -jar papeleria/build/libs/*.jar",
    "restartPolicyType": "ON_FAILURE"
  }
}
